[global]
    # Display configuration
    monitor = 0
    follow = mouse

    # Geometry
    width = (0, 300)
    height = 300
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 5

    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300 # General styling
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#504945"
    separator_color = "frame"
    sort = yes

    # Text formatting
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    # Gruvbox Dark: Dark background, light gray text, gray frame
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#504945"
    timeout = 5

[urgency_normal]
    # Gruvbox Dark: Dark background, light text, blue accent for normal
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#458588"
    timeout = 10

[urgency_critical]
    # Gruvbox Dark: Dark background, bright red accent and white text for critical
    background = "#282828"
    foreground = "#fbf1c7"
    frame_color = "#cc241d"
    timeout = 0
